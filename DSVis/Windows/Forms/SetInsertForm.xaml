<Window x:Class="DSVis.Windows.Forms.SetInsertForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DSVis.Windows.Forms"
        mc:Ignorable="d"
        Title="设置插入值" Height="228.222" Width="280" Topmost="True" Closed="MainWindow_Closed" ResizeMode="NoResize">
    <Grid>
        <Button Content="确认" HorizontalAlignment="Left" Height="30" Margin="101,149,0,0" VerticalAlignment="Top" Width="70
                " Click="Button_Click" IsDefault="True"/>
        <TextBox HorizontalAlignment="Left" Height="30" Margin="87,18,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="139" Name="textBox_value" RenderTransformOrigin="0.489,0.118" FontSize="16" VerticalContentAlignment="Center" PreviewTextInput="textBox_value_PreviewTextInput"/>
        <TextBox HorizontalAlignment="Left" Height="30" Margin="87,60,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="139" Name="textBox_posi" RenderTransformOrigin="0.489,0.118" FontSize="16" VerticalContentAlignment="Center" PreviewTextInput="textBox_posi_PreviewTextInput"/>
        <Label Content="数值" HorizontalAlignment="Left" Height="30" Margin="36,18,0,0" VerticalAlignment="Top" Width="46"/>
        <Label Content="位置" HorizontalAlignment="Left" Height="30" Margin="36,60,0,0" VerticalAlignment="Top" Width="46"/>
        <RadioButton Content="演示插入过程" Name="radioBtnStep" HorizontalAlignment="Left" Margin="135,125,0,0" VerticalAlignment="Top" GroupName="radioBtnMode"/>
        <RadioButton Content="直接插入" Name="radioBtnDir" HorizontalAlignment="Left" Margin="43,125,0,0" VerticalAlignment="Top" GroupName="radioBtnMode" IsChecked="True"/>
        <Label Content="如果位置过大，将自动插入到队尾" HorizontalAlignment="Left" Height="30" Margin="36,95,0,0" VerticalAlignment="Top" Width="190"/>

    </Grid>
</Window>
