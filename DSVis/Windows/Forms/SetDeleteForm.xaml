<Window x:Class="DSVis.Windows.Forms.SetDeleteForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DSVis.Windows.Forms"
        mc:Ignorable="d"
        Title="设置删除值" Height="228.222" Width="280" Topmost="True" Closed="MainWindow_Closed" ResizeMode="NoResize">
    <Grid Margin="0,0,-0.333,-28">
        <Button Content="确认" HorizontalAlignment="Left" Height="30" Margin="100,140,0,0" VerticalAlignment="Top" Width="70
                " Click="Button_Click" IsDefault="True"/>
        <TextBox InputMethod.IsInputMethodEnabled="False" HorizontalAlignment="Left" Height="30" Margin="87,23,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="139" Name="textBox" RenderTransformOrigin="0.489,0.118" FontSize="16" VerticalContentAlignment="Center" PreviewTextInput="textBox_PreviewTextInput"/>
        <Label Content="位置" HorizontalAlignment="Left" Height="30" Margin="43,23,0,0" VerticalAlignment="Top" Width="46"/>
        <RadioButton Content="演示删除过程" Name="radioBtnStep" HorizontalAlignment="Left" Margin="135,120,0,0" VerticalAlignment="Top" GroupName="radioBtnMode"/>
        <RadioButton Content="直接删除" Name="radioBtnDir" HorizontalAlignment="Left" Margin="43,120,0,0" VerticalAlignment="Top" GroupName="radioBtnMode" IsChecked="True"/>
        <Label Content="位置即空位标号&#x0a;即相对于链表尾部的后一个节点" HorizontalAlignment="Left" Height="41" Margin="43,58,0,0" VerticalAlignment="Top" Width="183"/>
        <Label Content="如果位置过大，将自动删除队尾" HorizontalAlignment="Left" Height="27" Margin="43,94,0,0" VerticalAlignment="Top" Width="183"/>

    </Grid>
</Window>
