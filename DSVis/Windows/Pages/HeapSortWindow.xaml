<Page x:Class="DSVis.Windows.Pages.HeapSortWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DSVis.Windows.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HeapSortWindow">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="#FFF4F4F5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="170" Name="CtrlBg" Panel.ZIndex="100">
            <Button Content="下一步" HorizontalAlignment="Left" Height="32" Margin="55,200,0,0" VerticalAlignment="Top" Width="59" Name="btnNext" IsEnabled="False" Click="btnNext_Click"/>
            <RadioButton Content="大根堆" HorizontalAlignment="Left" Height="14" Margin="35,75,0,0" VerticalAlignment="Top" Width="97" GroupName="Way" Name="radiobtnMax" IsEnabled="False"/>
            <RadioButton Content="小根堆" HorizontalAlignment="Left" Height="14" Margin="35,96,0,0" VerticalAlignment="Top" Width="97" GroupName="Way" Name="radiobtnMin" IsEnabled="False"/>
            <TextBlock HorizontalAlignment="Left" Height="37" Margin="17,117,0,0" TextWrapping="Wrap" Text="原数组" VerticalAlignment="Top" Width="134" x:Name="textOrigin"/>
            <TextBlock HorizontalAlignment="Left" Height="37" Margin="18,158,0,0" TextWrapping="Wrap" Text="堆" VerticalAlignment="Top" Width="134" x:Name="textHeap"/>
            <Button Content="设置初始" HorizontalAlignment="Left" Height="34" Margin="18,28,0,0" VerticalAlignment="Top" Width="60" x:Name="btnSet" Click="btnSet_Click" />
            <Button Content="添加结点" HorizontalAlignment="Left" Height="34" Margin="92,28,0,0" VerticalAlignment="Top" Width="60" x:Name="btnAdd" IsEnabled="False" Click="btnAdd_Click"/>
        </Grid>
        <Canvas Grid.Column="1" HorizontalAlignment="Stretch" Margin="15,0,15,0" VerticalAlignment="Stretch" x:Name="MainCanvas" Background="White"/>
    </Grid>
</Page>
