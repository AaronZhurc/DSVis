<Page x:Name="MainWindow" x:Class="DSVis.Windows.Pages.LabyrinthWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DSVis.Windows.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LabyrinthWindows">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="#FFF4F4F5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="170" x:Name="CtrlBg" Panel.ZIndex="100">
            <Button Content="自动生成迷宫" HorizontalAlignment="Left" Height="34" Margin="17,26,0,0" VerticalAlignment="Top" Width="135" x:Name="btnSet" Click="btnSet_Click"/>
            <Button Content="下一步" HorizontalAlignment="Left" Height="32" Margin="54,72,0,0" VerticalAlignment="Top" Width="59" x:Name="btnNext" Click="btnNext_Click" IsEnabled="False"/>
        </Grid>
        <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Canvas Grid.Column="0" x:Name="MainMaze" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="White" Margin="0,10,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="栈" Height="20" HorizontalAlignment="Center"/>
                <Canvas Grid.Row="1" x:Name="MainStack" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#FFF4F4F5"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
