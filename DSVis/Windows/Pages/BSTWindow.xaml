<Page x:Name="MainWindow" x:Class="DSVis.Windows.Pages.BSTWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DSVis.Windows.Pages"
        mc:Ignorable="d"
        Height="422" Width="793">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="#FFF4F4F5" HorizontalAlignment="Left" Height="{Binding ActualHeight,ElementName=MainWindow,Mode=OneWay}" VerticalAlignment="Top" Width="170" Name="CtrlBg" Panel.ZIndex="100">
            <Button Content="设置数组" HorizontalAlignment="Left" Height="34" Margin="17,26,0,0" VerticalAlignment="Top" Width="135" Name="btnSetWeight" Click="btnSetWeight_Click"/>
            <Button Content="下一步" HorizontalAlignment="Left" Height="32" Margin="53,232,0,0" VerticalAlignment="Top" Width="59" Name="btnNext" IsEnabled="False" Click="btnNext_Click"/>
            <TextBlock HorizontalAlignment="Left" Height="57" Margin="18,65,0,0" TextWrapping="Wrap" Text="原数组" VerticalAlignment="Top" Width="134" Name="textOrigin"/>
            <TextBlock HorizontalAlignment="Left" Height="58" Margin="18,127,0,0" TextWrapping="Wrap" Text="排序结果" VerticalAlignment="Top" Width="134" Name="textSorted"/>
            <RadioButton Content="二叉排序树" HorizontalAlignment="Left" Height="14" Margin="36,190,0,0" VerticalAlignment="Top" Width="97" GroupName="radiobtnWay" x:Name="radiobtnBST" IsEnabled="False" Checked="radiobtnBST_Checked" IsChecked="True"/>
            <RadioButton Content="二叉平衡树" HorizontalAlignment="Left" Height="14" Margin="36,209,0,0" VerticalAlignment="Top" Width="97" GroupName="radiobtnWay" x:Name="radiobtnAVL" IsEnabled="False" Checked="radiobtnAVL_Checked"/>
        </Grid>
        <Canvas Grid.Column="1" HorizontalAlignment="Stretch" Margin="15,0,15,0" VerticalAlignment="Stretch" Name="MainCanvas" Background="White"/>
    </Grid>
</Page>
