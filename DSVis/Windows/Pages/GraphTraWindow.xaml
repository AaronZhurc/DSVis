<Page x:Name="MainWindow" x:Class="DSVis.Windows.Pages.GraphTraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DSVis.Windows.Pages"
        mc:Ignorable="d"
        Title="图的遍历" Height="450" Width="800" Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="#FFF4F4F5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0" Width="170" Name="CtrlBg" Panel.ZIndex="100">
            <Button Content="绘制结点" HorizontalAlignment="Left" Height="34" Margin="18,28,0,0" VerticalAlignment="Top" Width="60" Name="btnSetVertex" Click="SetVertex_Click"/>
            <Button Content="绘制边" HorizontalAlignment="Left" Height="34" Margin="92,28,0,0" VerticalAlignment="Top" Width="60" Name="btnSetEdge" Click="SetEdge_Click" IsEnabled="False"/>
            <RadioButton Content="深度优先遍历" HorizontalAlignment="Left" Height="14" Margin="34,122,0,0" VerticalAlignment="Top" Width="97" GroupName="radiobtnWay" Name="radiobtnDFS" IsEnabled="False"/>
            <RadioButton Content="广度优先遍历" HorizontalAlignment="Left" Height="14" Margin="34,141,0,0" VerticalAlignment="Top" Width="97" GroupName="radiobtnWay" Name="radiobtnBFS" IsEnabled="False"/>
            <Button Content="清空画面" HorizontalAlignment="Left" Height="34" Margin="92,74,0,0" VerticalAlignment="Top" Width="60" Name="btnClean" Click="btnClean_Click" IsEnabled="False"/>
            <Button Content="确认画面" HorizontalAlignment="Left" Height="34" Margin="18,74,0,0" VerticalAlignment="Top" Width="60" Name="btnConfirm" Click="btnConfirm_Click" IsEnabled="False"/>
            <Button Content="下一步" HorizontalAlignment="Left" Height="32" Margin="55,166,0,0" VerticalAlignment="Top" Width="59" Name="btnNext" IsEnabled="False" Click="btnNext_Click"/>
            <TextBlock HorizontalAlignment="Left" Height="94" Margin="18,209,0,0" TextWrapping="Wrap" Text="遍历结果:" VerticalAlignment="Top" Width="134" Name="textResult"/>
        </Grid>
        <Canvas Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Stretch" Name="MainCanvas" MouseMove="MainCanvas_MouseMove" MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown" MouseLeftButtonUp="MainCanvas_MouseLeftButtonUp" Background="White" >
                <Line Name="line" Stroke="Black" StrokeThickness="1"/>
        </Canvas>
        
        
    </Grid>
    
</Page>
