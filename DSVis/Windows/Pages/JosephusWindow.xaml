<Page x:Class="DSVis.Windows.Pages.JosephusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DSVis.Windows.Pages"
        mc:Ignorable="d"
        Title="约瑟夫问题" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="#FFF4F4F5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="170" Name="CtrlBg" Panel.ZIndex="100">
            <Button Content="设置" HorizontalAlignment="Left" Height="34" Margin="17,26,0,0" VerticalAlignment="Top" Width="135" Name="btnSet" Click="btnSet_Click"/>
            <Button Content="下一步" HorizontalAlignment="Left" Height="32" Margin="54,164,0,0" VerticalAlignment="Top" Width="59" Name="btnNext" IsEnabled="False" Click="btnNext_Click"/>
            <TextBlock HorizontalAlignment="Left" Height="76" Margin="17,83,0,0" TextWrapping="Wrap" Text="清除出去的编号" VerticalAlignment="Top" Width="134" Name="textOut"/>
        </Grid>
        <Canvas Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="MainCanvas" Background="White" Panel.ZIndex="0"/>
    </Grid>
</Page>
