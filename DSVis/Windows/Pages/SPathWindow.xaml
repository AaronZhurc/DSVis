<Page x:Class="DSVis.Windows.Pages.SPathWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DSVis.Windows.Pages" xmlns:tools="clr-namespace:DSVis.Tools"
        mc:Ignorable="d"
        Title="最短路径" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="#FFF4F4F5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="170" Name="CtrlBg" Panel.ZIndex="100">
            
            <Button Content="绘制结点" HorizontalAlignment="Left" Height="34" Margin="18,16,0,0" VerticalAlignment="Top" Width="60" Name="btnSetVertex" Click="btnSetVertex_Click"/>
            <Button Content="绘制边" HorizontalAlignment="Left" Height="34" Margin="92,16,0,0" VerticalAlignment="Top" Width="60" Name="btnSetEdge" Click="btnSetEdge_Click" IsEnabled="False"/>
            <Button Content="设置权值" HorizontalAlignment="Left" Height="34" Margin="18,64,0,0" VerticalAlignment="Top" Width="60" Name="btnSetWeight" IsEnabled="False" Click="btnSetWeight_Click"/>
            <Button Content="确认画面" HorizontalAlignment="Left" Height="34" Margin="92,64,0,0" VerticalAlignment="Top" Width="60" Name="btnConfirm" Click="btnConfirm_Click" IsEnabled="False"/>
            <Button Content="清空画面" HorizontalAlignment="Left" Height="34" Margin="18,108,0,0" VerticalAlignment="Top" Width="60" Name="btnClean" Click="btnClean_Click" IsEnabled="False"/>
            <RadioButton Content="1到多最短路径" HorizontalAlignment="Left" Height="14" Margin="34,158,0,0" VerticalAlignment="Top" Width="97" GroupName="Way" Name="radiobtn12N" IsEnabled="False" Checked="radiobtn12N_Checked"/>
            <RadioButton Content="Dijkstra算法" HorizontalAlignment="Left" Height="14" Margin="34,179,0,0" VerticalAlignment="Top" Width="97" GroupName="Way" Name="radiobtnDij" IsEnabled="False" Checked="radiobtnDij_Checked"/>
            <Button Content="下一步" HorizontalAlignment="Left" Height="32" Margin="55,202,0,0" VerticalAlignment="Top" Width="59" Name="btnNext" IsEnabled="False" Click="btnNext_Click"/>
        </Grid>
        <Canvas Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="MainCanvas" Background="White" MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown" MouseLeftButtonUp="MainCanvas_MouseLeftButtonUp" MouseMove="MainCanvas_MouseMove" >
            <tools:Arrow x:Name="line" Stroke="Black" StrokeThickness="1"/>
        </Canvas>
    </Grid>
</Page>
