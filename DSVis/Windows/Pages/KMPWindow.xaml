<Page x:Class="DSVis.Windows.Pages.KMPWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DSVis.Windows.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="KMPWindow">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="#FFF4F4F5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="170" Name="CtrlBg" Panel.ZIndex="100">
            <Button Content="设置串" HorizontalAlignment="Left" Height="34" Margin="17,26,0,0" VerticalAlignment="Top" Width="135" x:Name="btnString" Click="btnString_Click"/>
            <Button Content="下一步" HorizontalAlignment="Left" Height="32" Margin="54,128,0,0" VerticalAlignment="Top" Width="59" Name="btnNext" IsEnabled="False" Click="btnNext_Click"/>
            <RadioButton Content="next数组" HorizontalAlignment="Left" Height="14" Margin="35,77,0,0" VerticalAlignment="Top" Width="97" GroupName="Way" Name="radiobtnNext" IsEnabled="False" IsChecked="true"/>
            <RadioButton Content="优化next数组" HorizontalAlignment="Left" Height="14" Margin="35,98,0,0" VerticalAlignment="Top" Width="97" GroupName="Way" Name="radiobtnNextval" IsEnabled="False"/>
        </Grid>
        <Canvas Grid.Column="1" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" Name="MainCanvas" Background="White"/>

    </Grid>
</Page>
