<Page x:Class="DSVis.Windows.Pages.LinearBasicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DSVis.Windows.Pages"
        mc:Ignorable="d"
        Title="线性结构基本操作" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="#FFF4F4F5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="170" x:Name="CtrlBg" Grid.RowSpan="2" Panel.ZIndex="100">
            <Button Content="设置" HorizontalAlignment="Left" Height="34" Margin="17,26,0,0" VerticalAlignment="Top" Width="135" Name="btnSet" Click="btnSet_Click"/>
            <Button Content="插入" HorizontalAlignment="Left" Height="34" Margin="18,75,0,0" VerticalAlignment="Top" Width="60" Name="btnPush" Click="btnPush_Click"/>
            <Button Content="删除" HorizontalAlignment="Left" Height="34" Margin="92,75,0,0" VerticalAlignment="Top" Width="60" Name="btnPop" Click="btnPop_Click"/>
            <RadioButton Content="单链表" HorizontalAlignment="Left" Height="14" Margin="21,137,0,0" VerticalAlignment="Top" Width="61" GroupName="radiobtnWay" Name="radiobtnSList" Checked="radiobtnSList_Checked"/>
            <RadioButton Content="双链表" HorizontalAlignment="Left" Height="14" Margin="87,137,0,0" VerticalAlignment="Top" Width="61" GroupName="radiobtnWay" Name="radiobtnDList" Checked="radiobtnDList_Checked"/>
            <RadioButton Content="栈" HorizontalAlignment="Left" Height="14" Margin="21,171,0,0" VerticalAlignment="Top" Width="35" GroupName="radiobtnWay" Name="radiobtnStack" Checked="radiobtnStack_Checked"/>
            <RadioButton Content="队列" HorizontalAlignment="Left" Height="14" Margin="87,171,0,0" VerticalAlignment="Top" Width="43" GroupName="radiobtnWay" Name="radiobtnQueue" Checked="radiobtnQueue_Checked"/>
            <Button Content="下一步" HorizontalAlignment="Left" Height="32" Margin="58,222,0,0" VerticalAlignment="Top" Width="59" Name="btnNext" Click="btnNext_Click"/>
        </Grid>
        <Canvas Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="MainCanvas" Background="White"/>
    </Grid>
</Page>
