<Page x:Class="DSVis.Windows.Pages.CriticalPathWindows"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DSVis.Windows.Pages" xmlns:tools="clr-namespace:DSVis.Tools"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CriticalPathWindows">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="#FFF4F4F5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="170" Name="CtrlBg" Panel.ZIndex="100">
            <Button Content="绘制结点" HorizontalAlignment="Left" Height="34" Margin="18,28,0,0" VerticalAlignment="Top" Width="60" x:Name="btnSetVertex" Click="SetVertex_Click"/>
            <Button Content="设置权值" HorizontalAlignment="Left" Height="34" Margin="18,74,0,0" VerticalAlignment="Top" Width="60" x:Name="btnSetWeight" Click="SetWeight_Click" IsEnabled="False"/>
            <Button Content="清空画面" HorizontalAlignment="Left" Height="34" Margin="18,122,0,0" VerticalAlignment="Top" Width="60" x:Name="btnClean" Click="btnClean_Click" IsEnabled="False"/>
            <Button Content="确认画面" HorizontalAlignment="Left" Height="34" Margin="92,74,0,0" VerticalAlignment="Top" Width="60" x:Name="btnConfirm" Click="btnConfirm_Click" IsEnabled="False"/>
            <Button Content="下一步" HorizontalAlignment="Left" Height="32" Margin="56,168,0,0" VerticalAlignment="Top" Width="59" x:Name="btnNext" IsEnabled="False" Click="btnNext_Click"/>
            <Button Content="绘制边" HorizontalAlignment="Left" Height="34" Margin="92,28,0,0" VerticalAlignment="Top" Width="60" x:Name="btnSetEdge" Click="SetEdge_Click" IsEnabled="False"/>
        </Grid>
        <Canvas Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" x:Name="MainCanvas"  MouseMove="MainCanvas_MouseMove" MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown" MouseLeftButtonUp="MainCanvas_MouseLeftButtonUp"  Background="White" >
            <tools:Arrow x:Name="line" Stroke="Black" StrokeThickness="1"/>
        </Canvas>
    </Grid>
</Page>
